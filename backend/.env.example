# ---------------------------------------------------------------
# Model provider: gemini | claude | ollama | mock
#   gemini -> Gemini API key from Google AI Studio (no GCP project needed)
#   claude -> Anthropic API key from https://console.anthropic.com
#   ollama -> fully offline, local models via Ollama + LiteLLM
#   mock   -> no model at all; canned responses to test the pipeline
# ---------------------------------------------------------------
ADVISOR_PROVIDER=mock

# --- Option A: Gemini API key (Google AI Studio) ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Check current model codes at https://ai.google.dev/gemini-api/docs/models before running
GEMINI_STRONG_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# --- Option B: Claude (Anthropic API key) ---
ANTHROPIC_API_KEY=
CLAUDE_STRONG_MODEL=claude-opus-5-5     # Analyzer + Reviewer
CLAUDE_FAST_MODEL=claude-opus-5-5       # specialists; claude-sonnet-5-5 is cheaper and faster
CLAUDE_STRONG_EFFORT=high               # low | medium | high | xhigh | max
CLAUDE_FAST_EFFORT=medium

# --- Option C: Ollama (offline) ---
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_STRONG_MODEL=ollama_chat/qwen2.5:14b
OLLAMA_FAST_MODEL=ollama_chat/qwen2.5:7b

# --- Token budgets (optional) ---
# Monthly token allowance per provider, shown in the web app as "remaining". 0 = not set.
GEMINI_TOKEN_BUDGET=0
CLAUDE_TOKEN_BUDGET=0

# --- Pipeline settings ---
ADVISOR_MAX_REWORK_ROUNDS=3
ADVISOR_APPROVAL_OVERALL=80
ADVISOR_APPROVAL_REQUIREMENT_FIT=85
ADVISOR_MIN_SUBSCORE=60
# true = also show each sub-agent's raw JSON as chat messages (debugging)
ADVISOR_SHOW_AGENT_OUTPUTS=false
# Run log: set a Postgres URL to use Postgres; leave empty for the local SQLite file below
ADVISOR_DATABASE_URL=
ADVISOR_DB_PATH=outputs/runs.sqlite
# --- Sign-in ---
# google = Google Workspace SSO; dev = email form for local work (never on a shared server)
ADVISOR_AUTH_MODE=google
# OAuth client (Google Cloud console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be listed under the client's "Authorized redirect URIs"
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
ADVISOR_ALLOWED_DOMAINS=searce.com
# Comma-separated; always admin (use to create the first admin)
ADVISOR_ADMIN_EMAILS=
# Where the browser lands after sign-in
ADVISOR_FRONTEND_URL=http://localhost:5173
ADVISOR_SESSION_TTL_HOURS=12
# Set true behind HTTPS (automatic when ADVISOR_FRONTEND_URL is https)
# ADVISOR_COOKIE_SECURE=true
# lax when frontend and API share a site; none (plus secure) for different sites
# ADVISOR_COOKIE_SAMESITE=lax

# --- Logs ---
# text (readable) or json (one object per line, for Cloud Logging)
ADVISOR_LOG_FORMAT=text
ADVISOR_LOG_LEVEL=INFO

# Frontend address(es) allowed to call this API from the browser, comma-separated
ADVISOR_CORS_ORIGINS=http://localhost:5173
ADVISOR_OUTPUT_DIR=outputs
