{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "advisor",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "advisor.api:app", "--port", "8091"],
      "port": 8091
    },
    {
      "name": "advisor-mock",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "set ADVISOR_PROVIDER=mock&& .venv\\Scripts\\python.exe -m uvicorn advisor.api:app --port 8092"],
      "port": 8092
    }
  ]
}
