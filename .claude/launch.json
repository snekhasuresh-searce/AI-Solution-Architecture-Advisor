{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "advisor.api:app",
        "--app-dir",
        "backend",
        "--port",
        "8091"
      ],
      "port": 8091
    },
    {
      "name": "backend-mock",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": [
        "/c",
        "set ADVISOR_PROVIDER=mock&& backend\\.venv\\Scripts\\python.exe -m uvicorn advisor.api:app --app-dir backend --port 8092"
      ],
      "port": 8092
    }
  ]
}
